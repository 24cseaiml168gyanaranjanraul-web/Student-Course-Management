// Styling
// ====================

const styles = {
  navbar: {
    backgroundColor: "#2563eb",
    color: "white",
    padding: "20px 40px",
    display: "flex",
    justifyContent: "space-between",
    alignItems: "center",
  },

  link: {
    color: "white",
